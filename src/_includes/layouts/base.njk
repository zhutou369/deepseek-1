<!DOCTYPE html>
<html lang="zh-HK">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  {% set docTitle = title or site.title %}
  {% set metaDescription = description or site.description %}
  {% set canonicalPath = canonicalUrl or page.url or "/" %}
  {% set canonical = site.url + canonicalPath %}
  <title>{% if page.url != "/" %}{{ docTitle }} | {{ site.brand }}{% else %}{{ site.title }}{% endif %}</title>
  <meta name="description" content="{{ metaDescription }}">
  <meta name="keywords" content="{{ pageKeywords or site.keywords }}">
  {% if noindex %}
  <meta name="robots" content="noindex,follow">
  {% else %}
  <meta name="robots" content="index,follow,max-image-preview:large">
  {% endif %}
  <link rel="canonical" href="{{ canonical }}">
  <meta property="og:type" content="{% if layout == 'layouts/post.njk' %}article{% else %}website{% endif %}">
  <meta property="og:title" content="{{ docTitle }}">
  <meta property="og:description" content="{{ metaDescription }}">
  <meta property="og:url" content="{{ canonical }}">
  <meta property="og:site_name" content="{{ site.brand }}">
  <meta property="og:locale" content="{{ site.locale }}">
  <meta name="twitter:card" content="summary">
  <meta name="baidu-site-verification" content="codeva-gbRwIYdftJ">
  <script type="application/ld+json">
{{ {
  "@context": "https://schema.org",
  "@type": "WebSite",
  "name": site.brand,
  "url": site.url,
  "description": site.description
} | dump | safe }}
  </script>

  <style>
    :root { --main-indigo: #4338ca; --tech-gray: #1e293b; --soft-bg: #f8fafc; --text-dark: #0f172a; }
    body { font-family: 'Segoe UI', Roboto, sans-serif; line-height: 1.7; color: var(--text-dark); margin: 0; padding: 0; background: #fff; }
    .container { max-width: 1100px; margin: 0 auto; padding: 0 25px; }
    .site-header { background: #fff; border-bottom: 1px solid #e5e7eb; padding: 18px 0; position: sticky; top: 0; z-index: 999; }
    .nav-flex { display: flex; justify-content: space-between; align-items: center; }
    .logo-box a { text-decoration: none; color: var(--main-indigo); font-weight: 800; font-size: 20px; letter-spacing: 1px; }
    .logo-box div { font-weight: 800; font-size: 20px; color: var(--main-indigo); }
    .nav-menu { list-style: none; display: flex; gap: 30px; margin: 0; padding: 0; }
    .nav-menu a { text-decoration: none; color: #4b5563; font-weight: 500; transition: 0.3s; }
    .nav-menu a:hover, .nav-menu a.active { color: var(--main-indigo); }
    .site-footer { background: var(--tech-gray); color: #94a3b8; padding: 60px 0 30px; margin-top: 80px; }
    .footer-friends h4 { color: #f1f5f9; font-size: 16px; margin-bottom: 20px; }
    .friend-links-grid { display: flex; flex-wrap: wrap; gap: 15px 35px; border-bottom: 1px solid #334155; padding-bottom: 30px; margin-bottom: 30px; }
    .friend-links-grid a { color: #cbd5e1; text-decoration: none; font-size: 14px; transition: 0.2s; }
    .friend-links-grid a:hover { color: #fff; }
    .copyright { text-align: center; font-size: 13px; color: #64748b; }
  </style>

  <script charset="UTF-8" id="LA_COLLECT" src="//sdk.51.la/js-sdk-pro.min.js" defer></script>
  <script>window.addEventListener("load",function(){if(window.LA){LA.init({id:"{{ site.laId }}",ck:"{{ site.laId }}"})}})</script>
</head>
<body>

  <header class="site-header">
    <div class="container nav-flex">
      {% if page.url == "/" %}
        <h1 class="logo-box" style="margin:0;"><a href="/">{{ site.brand }}</a></h1>
      {% else %}
        <div class="logo-box"><a href="/">{{ site.brand }}</a></div>
      {% endif %}
      <nav>
        <ul class="nav-menu">
          <li><a href="/" {% if page.url == "/" %}class="active"{% endif %}>首頁</a></li>
          <li><a href="/posts/" {% if page.url.startsWith('/posts/') %}class="active"{% endif %}>技術文章</a></li>
        </ul>
      </nav>
    </div>
  </header>

  <main>
    {{ content | safe }}
  </main>

  <footer class="site-footer">
    <div class="container">
      <div class="footer-friends">
        <h4>相關 DeepSeek 資料站</h4>
        <div class="friend-links-grid">
          <a href="https://deepseek-chat.com" target="_blank" rel="noopener">DeepSeek 對話入口整理</a>
          <a href="https://hk-deepseek.com" target="_blank" rel="noopener">DeepSeek 香港繁體資料</a>
          <a href="https://deepseek-in.com" target="_blank" rel="noopener">DeepSeek 國際版說明</a>
          <a href="https://deepseek-my.com" target="_blank" rel="noopener">DeepSeek 馬來西亞資料</a>
        </div>
      </div>
      <div class="copyright">
        <p>&copy; 2026 {{ site.brand }} · 本站為第三方使用說明與技術整理，非 DeepSeek 官方網站。</p>
      </div>
    </div>
  </footer>

</body>
</html>
